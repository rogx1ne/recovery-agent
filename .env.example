# Razorpay Test Mode credentials
# Get these from: https://dashboard.razorpay.com/app/keys (Test Mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini API key (FREE tier — 15 requests/min, 1M tokens/day)
# Get it at: https://aistudio.google.com/app/apikey
# Leave blank to use the rules-based classifier instead (still works).
GEMINI_API_KEY=AIzaSy_your_key_here

# Application settings
APP_ENV=development
DATABASE_URL=sqlite:///./recovery_agent.db

# Recovery policy settings (in seconds)
CARD_DECLINED_RETRY_DELAY_SECONDS=5
GATEWAY_ERROR_RETRY_DELAY_SECONDS=2

# Payment link settings
PAYMENT_LINK_EXPIRE_MINUTES=60
CALLBACK_URL=http://localhost:8000/api/v1/transactions/callback
